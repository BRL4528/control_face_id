#!/usr/bin/env bash
# Diz se a pista de testes esta livre, e sai com 1 quando ocupada -- entao
#   ./bin/pista && npx playwright test <alvo>
# e um portao de verdade, sem depender de alguem LER a saida.
#
# TODO detector filtra por EXECUTAVEL REAL (/proc/PID/comm), nunca so pela linha
# de comando. O truque do colchete protege o pgrep de casar CONSIGO e nao
# protege de casar com o SHELL que apenas carrega a string -- qualquer comando
# composto que mencione "playwright test" aparecia como OCUPADO, com PID novo a
# cada foto e ja morto quando alguem ia conferir. Isso custou uma investigacao
# de pista fantasma, e o conserto ja existia aqui aplicado a UM dos tres
# detectores: filtro parcial e pior que nenhum, porque os dois que faltavam
# pareciam cobertos.
set -u

# $1 = pids, $2 = PREFIXOS de comm aceitos, separados por espaco.
# PREFIXO e nao nome exato porque o Linux corta /proc/PID/comm em 15 CARACTERES:
# chrome-headless-shell  -> "chrome-headless"
# chrome_crashpad_handler -> "chrome_crashpad"
# Lista de nomes completos nunca casa binario de nome longo, e o sintoma e
# SILENCIO e nao erro -- foi assim que a primeira versao deste filtro deixou de
# ver o navegador do playwright inteiro. O truncamento nao aparece em lugar
# nenhum do codigo, entao vai voltar a morder se o casamento for exato.
so_comm() {
  for p in $1; do
    c=$(cat "/proc/$p/comm" 2>/dev/null) || continue
    for pref in $2; do case "$c" in "$pref"*) printf '%s ' "$p"; break;; esac; done
  done
}

alvo=$(so_comm   "$(pgrep -f 'playwright test')" "node")
chrome=$(so_comm "$(pgrep -f 'remote-debugging|--headless')" "chrome chromium headless_shell headless")
serve=$(so_comm  "$(pgrep -f '(tests/e2e/servir\.js|(visual|proxy|servir)[^/]*\.(mjs|cjs|js))')" "node")

ocupado=0
[ -n "${alvo// /}" ]   && { echo "OCUPADO playwright: $alvo"; ocupado=1; }
[ -n "${chrome// /}" ] && { echo "OCUPADO navegador: $chrome"; ocupado=1; }
[ -n "${serve// /}" ]  && { echo "servidor de serve de pe: $serve (derrube quando terminar)"; }

if [ "$ocupado" = 0 ]; then
  echo "LIVRE  $(date -Is)"
  echo
  echo "  Isto e UMA FOTO deste instante, nao procedencia da sua rodada:"
  echo "  alguem pode entrar um segundo depois. Vale como CONDICAO DE ENTRADA."
  echo "  Ao reportar numero, use uma das duas frases:"
  echo "    - \"janela travada, todos confirmaram parada\"  <- medicao valida"
  echo "    - \"sem travar janela, pista LIVRE na entrada\"  <- honesta, nao valida"
fi
exit "$ocupado"
