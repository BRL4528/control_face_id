#!/usr/bin/env bash
# Diz se a pista de testes esta livre, e sai com 1 quando ocupada -- entao
#   ./bin/pista && npx playwright test <alvo>
# e um portao de verdade, sem depender de alguem LER a saida.
#
# TODO detector filtra por EXECUTAVEL REAL (/proc/PID/comm), nunca so pela linha
# de comando. O truque do colchete protege o pgrep de casar CONSIGO e nao
# protege de casar com o SHELL que apenas carrega a string -- qualquer comando
# composto que mencione "playwright test" aparecia como OCUPADO, com PID novo a
# cada foto e ja morto quando alguem ia conferir. Isso custou uma investigacao
# de pista fantasma, e o conserto ja existia aqui aplicado a UM dos tres
# detectores: filtro parcial e pior que nenhum, porque os dois que faltavam
# pareciam cobertos.
set -u

# $1 = pids, $2 = basenames de executavel aceitos, separados por espaco.
# Usa /proc/PID/exe (symlink para o binario real) e NAO /proc/PID/comm, porque
# comm e cortado em 15 caracteres pelo kernel e o limite nao esta escrito em
# lugar nenhum: chrome-headless-shell chega como "chrome-headless" e
# chrome_crashpad_handler como "chrome_crashpad". Lista de nomes completos nunca
# casava, e o sintoma era SILENCIO -- o detector de navegador deixou de ver o
# navegador do playwright inteiro.
# exe resolve os dois lados de uma vez: nome completo sem truncagem, e o shell
# que apenas carrega a string aparece como bash e cai fora. Prefixo tambem
# funcionaria, mas seria contorno de um limite que este campo nao tem.
# Ressalvas: exige mesmo usuario (e o caso) e nao vale para kernel thread.
so_exe() {
  for p in $1; do
    b=$(basename "$(readlink -f "/proc/$p/exe" 2>/dev/null)" 2>/dev/null) || continue
    # PREFIXO e nao nome exato: o binario padrao do playwright headless e
    # chrome-headless-shell, e tres versoes seguidas desta ferramenta nao o viam
    # -- a primeira nao filtrava, a segunda cortava comm em 15 chars, a terceira
    # casava nome exato contra lista incompleta. exe resolve a truncagem;
    # prefixo resolve a lista. As duas juntas, nao uma no lugar da outra.
    for pref in $2; do case "$b" in "$pref"*) printf '%s ' "$p"; break;; esac; done
  done
}

alvo=$(so_exe    "$(pgrep -f 'playwright test')" "node")
# ATENCAO, DUAS METADES: este detector tem de ver o navegador DO PLAYWRIGHT e
# continuar CEGO ao navegador pessoal do usuario. O discriminador e o ARGV
# (remote-debugging / --headless), nao o nome do executavel -- os dois sao
# /opt/google/chrome/chrome.
# Medido: ha 18 processos de Chrome pessoal nesta maquina, com perfil em
# ~/.config/google-chrome. Se alguem "consertar" isto alargando para chrome ou
# chromium em geral -- que e a correcao obvia para "nao ve o navegador" -- a
# pista fica PERMANENTEMENTE OCUPADA, e portao que sempre barra treina a pessoa
# a contornar o portao. Seria o defeito mais caro desta ferramenta: mataria o
# uso dela, nao so a leitura. Preserve o filtro por argv. (Achado do QA.)
chrome=$(so_exe  "$(pgrep -f 'remote-debugging|--headless')" "chrome chromium headless")
serve=$(so_exe   "$(pgrep -f '(tests/e2e/servir\.js|(visual|proxy|servir)[^/]*\.(mjs|cjs|js))')" "node")

ocupado=0
[ -n "${alvo// /}" ]   && { echo "OCUPADO playwright: $alvo"; ocupado=1; }
[ -n "${chrome// /}" ] && { echo "OCUPADO navegador: $chrome"; ocupado=1; }
[ -n "${serve// /}" ]  && { echo "servidor de serve de pe: $serve (derrube quando terminar)"; }

if [ "$ocupado" = 0 ]; then
  echo "LIVRE  $(date -Is)"
  echo
  echo "  Isto e UMA FOTO deste instante, nao procedencia da sua rodada:"
  echo "  alguem pode entrar um segundo depois. Vale como CONDICAO DE ENTRADA."
  echo "  Ao reportar numero, use uma das duas frases:"
  echo "    - \"janela travada, todos confirmaram parada\"  <- medicao valida"
  echo "    - \"sem travar janela, pista LIVRE na entrada\"  <- honesta, nao valida"
fi
exit "$ocupado"
