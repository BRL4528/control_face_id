#!/usr/bin/env bash
# Diz se a pista de testes esta livre. Existe porque a versao "todos lembram"
# falhou no mesmo dia em que foi escrita, com o autor da regra: rodar o pgrep
# no MESMO comando que o resto do script faz o argv do bash casar com o proprio
# padrao, e aparece um processo que e voce. Regra que depende de memoria falha
# exatamente quando a atencao esta em outro lugar, que e sempre que ela importa.
#
# Cobre os dois recursos, nao so playwright: o navegador visivel (Chrome da flag
# NAVEGADOR) compete pelo mesmo CPU e nao aparece num filtro por "playwright".
set -u
alvo=$(pgrep -f '[p]laywright test' | tr '\n' ' ')
chrome=$(pgrep -f '[c]hrome --.*--remote-debugging|[c]hromium.*--headless' | tr '\n' ' ')
# Casa servir.js E proxy ad hoc de validacao visual (visual-*.mjs, proxy-*.js na
# raiz), porque servidor esquecido de pe foi incidente real: a porta 38975 ficou
# uma hora no ar. O caso que mais importa e justamente o proxy ad hoc, que a
# nossa propria regra manda usar para nao apontar navegador visivel a producao.
# Filtra por EXECUTAVEL real (/proc/PID/comm), nao pela linha de comando: o
# truque do colchete protege o pgrep de casar consigo, e NAO protege de casar
# com o shell que carrega a string. Foi assim que o QA quebrou a propria regra
# hoje, e assim que eu a quebrei de novo cinco minutos depois de escrever isto.
so_node() { for p in $1; do [ "$(cat /proc/$p/comm 2>/dev/null)" = node ] && printf '%s ' "$p"; done; }
serve=$(so_node "$(pgrep -f '(tests/e2e/servir\.js|(visual|proxy|servir)[^/]*\.(mjs|cjs|js))')")
ocupado=0
[ -n "${alvo// /}" ] && { echo "OCUPADO playwright: $alvo"; ocupado=1; }
[ -n "${chrome// /}" ] && { echo "OCUPADO navegador: $chrome"; ocupado=1; }
[ -n "${serve// /}" ] && { echo "servidor de serve de pe: $serve (derrube quando terminar)"; }
if [ "$ocupado" = 0 ]; then
  echo "LIVRE  $(date -Is)"
  echo
  echo "  Isto e UMA FOTO deste instante, nao procedencia da sua rodada:"
  echo "  alguem pode entrar um segundo depois. Vale como CONDICAO DE ENTRADA."
  echo "  Ao reportar numero, use uma das duas frases:"
  echo "    - \"janela travada, todos confirmaram parada\"  <- medicao valida"
  echo "    - \"sem travar janela, pista LIVRE na entrada\"  <- honesta, nao valida"
fi
# exit reflete o achado, senao `npm run pista && npx playwright test` e um portao
# que nunca fecha -- e a ferramenta volta a depender de alguem LER a saida, que e
# a dependencia de atencao que ela existe para remover. Achado do DevOps.
# Servidor de serve esquecido continua AVISO e nao bloqueio: nao disputa navegador.
exit "$ocupado"
