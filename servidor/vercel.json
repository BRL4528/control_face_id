{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash ./copiar-nucleo.sh",
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {
      "source": "/efrat/:caminho*",
      "destination": "/api/roteador?base=/efrat&caminho=:caminho*"
    },
    {
      "source": "/webhook/efrat/:caminho*",
      "destination": "/api/roteador?base=/webhook/efrat&caminho=:caminho*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none';"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
