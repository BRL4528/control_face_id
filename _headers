/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://n8n.samasc.com.br; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
  Permissions-Policy: camera=(self)
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY

/models/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

# Pagina publica de cadastro de face. MITIGACAO, NAO ISOLAMENTO: a pagina vai
# para uma origem propria (subdominio), porque IndexedDB e por origem e nao por
# caminho — ver o comentario em sw.js. Estas regras valem enquanto ela nao
# estiver mudada, e depois valem no vercel.json da origem nova.
#
# Link de uso unico e validade curta: servir de cache seria mostrar ao
# colaborador uma tela que o servidor ja invalidou. no-store vale para o
# documento e para o JS/CSS dela, que moram no mesmo prefixo — sao poucos KB.
# no-referrer porque o token viaja no fragmento do link. noindex porque link
# publico nao entra em buscador.
# A CSP nao muda: camera, vendor/ e models/ sao da propria origem e ja cabem na
# politica global — nada a afrouxar.
/cadastro
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

/cadastro/*
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
