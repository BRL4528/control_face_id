/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://n8n.samasc.com.br; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
  Permissions-Policy: camera=(self)
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY

/models/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

# Backstop da origem publica. A pagina de cadastro de face vive em origem
# propria (projeto separado da Vercel, Root Directory publico/) e .vercelignore
# tira publico/ do deploy do app — entao normalmente nada casa aqui.
#
# Estas regras valem para o caso de publico/ escapar para o deploy do app, onde
# responderia em /publico/*. Link de uso unico servido de cache mostraria ao
# colaborador uma tela que o servidor ja invalidou; noindex porque link publico
# nao entra em buscador; no-referrer porque o token viaja no fragmento.
#
# A CSP do app nao muda por causa da pagina publica, e nunca mudou: a origem
# nova tem a sua propria, em publico/vercel.json.
/publico
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

/publico/*
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
