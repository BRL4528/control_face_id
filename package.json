{
  "name": "control-face-id",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Ponto por reconhecimento facial 1:1 com cerca virtual — cada colaborador no próprio celular",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "serve": "node tests/e2e/servir.js",
    "dev": "vercel dev",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:seed": "node scripts/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.3"
  }
}
