# Variáveis de ambiente — configure na Vercel (Project Settings → Environment
# Variables) e localmente em .env para o `vercel dev`. NENHUMA entra no bundle
# do cliente: as functions rodam no servidor.

# Neon Postgres — copie a "connection string" pooled do painel do Neon.
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# Segredo para assinar o JWT do RH. Gere com: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Origens permitidas no CORS (o domínio do seu app na Vercel). * só em dev.
CORS_ORIGINS="*"

# Vercel Blob — token de leitura/escrita para guardar miniaturas de auditoria.
# Opcional: sem ele, as miniaturas ficam inline no banco (degrada, não quebra).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# Cron da renovação diária da escala (/api/cron/renovar-escala). A Vercel envia
# este valor no Authorization; sem ele o endpoint aceita qualquer chamada.
# Gere com: openssl rand -base64 32
CRON_SECRET="troque-por-um-segredo"
